      },
      "NovaConta": {
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "title": "Nome"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "corrente",
              "poupanca",
              "carteira"
            ],
            "title": "Tipo"
          }
        },
        "type": "object",
        "required": [
          "nome",
          "tipo"
        ],
        "title": "NovaConta"
      },
      "NovoLancamento": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "despesa",
              "receita"
            ],
            "title": "Tipo"
          },
          "valor_centavos": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Valor Centavos"
          },
          "data": {
            "type": "string",
            "format": "date",
            "title": "Data"
          },
          "descricao": {
            "type": "string",
            "title": "Descricao",
            "default": ""
          },
          "conta_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conta Id"
          },
          "categoria_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "minItems": 1,
            "title": "Categoria Ids"
          },
          "situacao": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "previsto",
                  "realizado"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Situacao"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tipo",
          "valor_centavos",
          "data",
          "conta_id",
          "categoria_ids"
        ],
        "title": "NovoLancamento"
      },
      "PedidoDeExportacao": {
        "properties": {
          "formato": {
            "type": "string",
            "enum": [
              "backup",
              "planilha"
            ],
