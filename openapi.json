  "components": {
    "schemas": {
      "Categoria": {
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "title": "Nome"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "despesa",
              "receita",
              "transferencia"
            ],
            "title": "Tipo"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "nome",
          "tipo",
          "id"
        ],
        "title": "Categoria"
      },
      "Confirmacao": {
        "properties": {
          "valor_centavos": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Valor Centavos"
          },
          "data": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "conta_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conta Id"
          }
        },
        "type": "object",
        "title": "Confirmacao",
        "description": "O que de fato aconteceu; campo ausente fica como estava no previsto."
      },
      "Conta": {
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "title": "Nome"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "corrente",
              "poupanca",
              "carteira"
            ],
            "title": "Tipo"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "nome",
          "tipo",
          "id"
        ],
        "title": "Conta"
      },
      "ContaComSaldo": {
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "title": "Nome"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "corrente",
              "poupanca",
              "carteira"
            ],
            "title": "Tipo"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "saldo_centavos": {
            "type": "integer",
            "title": "Saldo Centavos"
          }
        },
        "type": "object",
        "required": [
          "nome",
          "tipo",
          "id",
          "saldo_centavos"
        ],
        "title": "ContaComSaldo"
      },
      "ContasDaSemana": {
        "properties": {
          "lancamentos": {
            "items": {
              "$ref": "#/components/schemas/Lancamento"
            },
            "type": "array",
            "title": "Lancamentos"
          }
        },
        "type": "object",
        "required": [
          "lancamentos"
        ],
        "title": "ContasDaSemana",
        "description": "Previstos a confirmar: os atrasados e os dos próximos dias, do mais antigo ao mais novo."
      },
      "Eu": {
        "properties": {
          "usuario": {
            "type": "string",
            "title": "Usuario"
          }
        },
        "type": "object",
        "required": [
          "usuario"
        ],
        "title": "Eu"
      },
      "ExportacaoPronta": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "arquivo": {
            "type": "string",
            "title": "Arquivo"
          },
          "expira_em": {
            "type": "string",
            "format": "date-time",
            "title": "Expira Em"
          }
        },
        "type": "object",
        "required": [
          "url",
          "arquivo",
          "expira_em"
        ],
        "title": "ExportacaoPronta"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Lancamento": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "despesa",
              "receita"
            ],
            "title": "Tipo"
          },
          "valor_centavos": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Valor Centavos"
          },
          "data": {
            "type": "string",
            "format": "date",
            "title": "Data"
          },
          "descricao": {
            "type": "string",
            "title": "Descricao",
            "default": ""
          },
          "conta_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conta Id"
          },
          "categoria_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "minItems": 1,
            "title": "Categoria Ids"
          },
          "situacao": {
            "type": "string",
            "enum": [
              "previsto",
              "realizado"
            ],
            "title": "Situacao"
          },
          "atrasado": {
            "type": "boolean",
            "title": "Atrasado"
          },
          "criado_por": {
            "type": "string",
            "title": "Criado Por"
          },
          "criado_em": {
            "type": "string",
            "format": "date-time",
            "title": "Criado Em"
          },
          "alterado_por": {
            "type": "string",
            "title": "Alterado Por"
          },
          "alterado_em": {
            "type": "string",
            "format": "date-time",
            "title": "Alterado Em"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tipo",
          "valor_centavos",
          "data",
          "conta_id",
          "categoria_ids",
          "situacao",
          "atrasado",
          "criado_por",
          "criado_em",
          "alterado_por",
          "alterado_em"
        ],
        "title": "Lancamento"
      },
      "NovaCategoria": {
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "title": "Nome"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "despesa",
