  "components": {
    "schemas": {
      "AlteracaoDeCategoria": {
        "properties": {
          "nome": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nome"
          },
          "arquivada": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arquivada"
          }
        },
        "type": "object",
        "title": "AlteracaoDeCategoria",
        "description": "Só o nome e o arquivamento mudam; o tipo é fixo porque os lançamentos dependem dele."
      },
      "Categoria": {
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "title": "Nome"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "despesa",
              "receita",
              "transferencia"
            ],
            "title": "Tipo"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "arquivada": {
            "type": "boolean",
            "title": "Arquivada",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "nome",
          "tipo",
          "id"
        ],
        "title": "Categoria"
      },
      "Conta": {
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "title": "Nome"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "corrente",
              "poupanca",
              "carteira"
            ],
            "title": "Tipo"
          },
          "saldo_abertura_centavos": {
            "anyOf": [
              {
                "type": "integer"
