                  "title": "Response Listar Lancamentos"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "summary": "Criar Lancamento",
        "description": "Reenviar o mesmo id (a fila repete) devolve o que já está gravado, com 200.",
        "operationId": "criar_lancamento",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NovoLancamento"
