{
  "openapi": "3.1.0",
  "info": {
    "title": "Financial App",
    "version": "0.1.0"
  },
  "paths": {
    "/api/saude": {
      "get": {
        "summary": "Saude",
        "operationId": "saude",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saude"
                }
              }
            }
          }
        }
      }
    },
    "/api/eu": {
      "get": {
        "summary": "Eu",
        "operationId": "eu",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Eu"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/exportacoes": {
      "post": {
        "summary": "Exportacoes",
        "operationId": "exportar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoDeExportacao"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportacaoPronta"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Eu": {
        "properties": {
          "usuario": {
            "type": "string",
            "title": "Usuario"
          }
        },
        "type": "object",
        "required": [
          "usuario"
        ],
        "title": "Eu"
      },
      "ExportacaoPronta": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "arquivo": {
            "type": "string",
            "title": "Arquivo"
          },
          "expira_em": {
            "type": "string",
            "format": "date-time",
            "title": "Expira Em"
          }
        },
        "type": "object",
        "required": [
          "url",
          "arquivo",
          "expira_em"
        ],
        "title": "ExportacaoPronta"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PedidoDeExportacao": {
        "properties": {
          "formato": {
            "type": "string",
            "enum": [
              "backup",
              "planilha"
            ],
            "title": "Formato"
          }
        },
        "type": "object",
        "required": [
          "formato"
        ],
        "title": "PedidoDeExportacao"
      },
      "Saude": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "migrations": {
            "type": "integer",
            "title": "Migrations"
          }
        },
        "type": "object",
        "required": [
          "status",
          "migrations"
        ],
        "title": "Saude"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
