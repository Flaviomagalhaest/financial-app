      "post": {
        "summary": "Confirmar Lancamento",
        "description": "Confirmar de novo (a fila reenviou, a outra pessoa confirmou antes) devolve o gravado.",
        "operationId": "confirmar_lancamento",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id"
